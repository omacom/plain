pkgname=plain
pkgver=0.1.0
pkgrel=1
pkgdesc="Omarchy's text editor for config files"
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/plain "$pkgdir/usr/bin/plain"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/plain.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/plain.svg"
  install -Dm644 "$startdir/plain.desktop" "$pkgdir/usr/share/applications/plain.desktop"
}
