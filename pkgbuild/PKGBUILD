pkgname=plain
pkgver=0.2.0
pkgrel=1
pkgdesc="Omarchy's text editor for config files"
arch=('x86_64' 'aarch64')
url='https://github.com/omacom/plain'
license=('MIT')
depends=('hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('cmake' 'gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/plain "$pkgdir/usr/bin/plain"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/plain.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/plain.svg"
  install -Dm644 pkgbuild/plain.desktop "$pkgdir/usr/share/applications/plain.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
